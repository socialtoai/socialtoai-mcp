{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.socialtoai/socialtoai",
  "title": "SocialToAI",
  "description": "Social media data for AI agents: one MCP address, 18 platforms. Pay per call; failed calls are free.",
  "websiteUrl": "https://socialtoai.com/",
  "repository": {
    "url": "https://github.com/socialtoai/socialtoai-mcp",
    "source": "github"
  },
  "version": "2.2.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.socialtoai.com/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Optional. Clients sign in with OAuth by default; a developer tool may send a SocialToAI API key here instead, created at https://socialtoai.com/console/.",
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "search",
        "trending",
        "detail",
        "comments",
        "user_profile",
        "user_posts",
        "find",
        "call",
        "capabilities",
        "account",
        "brand_buzz",
        "comment_insights",
        "find_creators",
        "account_watch",
        "creator_card",
        "research",
        "watch",
        "watch_news"
      ]
    }
  }
}
